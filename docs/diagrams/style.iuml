' Kiểu vẽ chung cho bộ sơ đồ BrewLite: nền trắng, viền đen, chữ DejaVu Sans (hiển thị đủ dấu tiếng Việt)
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam backgroundColor white
skinparam ArrowColor black
skinparam ArrowFontSize 11
skinparam roundCorner 8
skinparam ActorBorderColor black
skinparam ActorBackgroundColor white
skinparam UsecaseBorderColor black
skinparam UsecaseBackgroundColor white
skinparam RectangleBorderColor black
skinparam RectangleBackgroundColor white
skinparam PackageBorderColor black
skinparam ParticipantBorderColor black
skinparam ParticipantBackgroundColor white
skinparam BoundaryBorderColor black
skinparam BoundaryBackgroundColor white
skinparam ControlBorderColor black
skinparam ControlBackgroundColor white
skinparam EntityBorderColor black
skinparam EntityBackgroundColor white
skinparam DatabaseBorderColor black
skinparam DatabaseBackgroundColor white
skinparam CollectionsBorderColor black
skinparam CollectionsBackgroundColor white
skinparam SequenceLifeLineBorderColor #555555
skinparam SequenceGroupBorderColor black
skinparam SequenceGroupBackgroundColor #F2F2F2
skinparam SequenceBoxBorderColor #999999
skinparam ActivityBorderColor black
skinparam ActivityBackgroundColor white
skinparam ActivityDiamondBorderColor black
skinparam ActivityDiamondBackgroundColor white
skinparam PartitionBorderColor black
skinparam SwimlaneBorderColor black
skinparam SwimlaneTitleFontStyle bold
skinparam ClassBorderColor black
skinparam ClassBackgroundColor white
skinparam ClassHeaderBackgroundColor #EDEDED
skinparam StateBorderColor black
skinparam StateBackgroundColor white
skinparam NoteBorderColor #888888
skinparam NoteBackgroundColor #FFFBE6
skinparam NodeBorderColor black
skinparam NodeBackgroundColor white
