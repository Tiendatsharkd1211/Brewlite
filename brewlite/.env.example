# Biến cho docker-compose.yml (run-docker.bat). Chép thành file .env cạnh file này rồi điền giá trị thật.
# File .env đã nằm trong .gitignore, không bao giờ commit.

# Khoá ký token đăng nhập: chuỗi ngẫu nhiên >= 32 ký tự (bắt buộc). Tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Mã cổng VNPay sandbox (đăng ký tại sandbox.vnpayment.vn); để trống thì chỉ trả được bằng điểm
VNP_TMN_CODE=
VNP_HASH_SECRET=

# Mật khẩu CSDL (bỏ trống dùng mặc định khi chạy trên máy cá nhân; đổi khi chạy thật)
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=

# Hiện tài khoản mẫu và thẻ thử VNPay khi demo (1 = hiện)
SHOW_DEMO_HINTS=
