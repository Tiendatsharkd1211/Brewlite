// Lược đồ CSDL BrewLite (PostgreSQL). Chạy `npm run db:push` để tạo bảng, `npm run seed` để nạp dữ liệu mẫu.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  READY
  COMPLETED
  CANCELLED
  PAYMENT_FAILED
}

enum PaymentMethod {
  MOMO
  ZALOPAY
  SHOPEEPAY
  VNPAY
  CARD
  POINTS
}

enum PaymentStatus {
  PROCESSING
  SUCCEEDED
  FAILED
}

/// Loại biến động số dư của tài khoản ảo
enum WalletTxType {
  OPENING // số dư ban đầu khi liên kết
  TOPUP // nạp thêm tiền
  PAYMENT // trừ tiền khi thanh toán đơn
}

enum Size {
  S
  M
  L
}

enum Fulfillment {
  PICKUP
  DELIVERY
}

enum VoucherType {
  PERCENT
  FREESHIP
}

model User {
  id            String               @id @default(uuid())
  email         String               @unique
  fullName      String
  passwordHash  String
  loyaltyPoints Int                  @default(0)
  createdAt     DateTime             @default(now())
  orders        Order[]
  loyaltyLogs   LoyaltyTransaction[]
  wallets       WalletAccount[]
}

model Product {
  id          String      @id // slug, ví dụ "bac-xiu"
  name        String
  description String
  price       Int // giá size S, đơn vị đồng
  imageUrl    String
  stock       Int // số ly/bánh còn bán được
  version     Int         @default(0) // optimistic locking: tăng 1 mỗi lần trừ/hoàn kho
  category    String
  kind        String // "drink" | "food"
  tag         String? // "hot" | "new"
  rating      Float       @default(5)
  sold        Int         @default(0)
  hasIce      Boolean     @default(true)
  color       String      @default("#6f4e37")
  keywords    String[]
  toppings    Topping[]
  orderItems  OrderItem[]
}

model Topping {
  id       String    @id
  name     String
  price    Int
  products Product[]
}

model Order {
  id            String        @id // mã đơn dễ đọc, ví dụ "BL482913"
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  status        OrderStatus   @default(PENDING)
  subtotal      Int
  fee           Int
  discount      Int
  total         Int
  voucherCode   String?
  paymentMethod PaymentMethod
  fulfillment   Fulfillment
  pickupTime    String
  address       String        @default("")
  pointsEarned  Int           @default(0)
  pointsUsed    Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  items         OrderItem[]
  payments      Payment[]

  @@index([userId, createdAt])
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  productName String
  size        Size?
  sugar       Int?
  ice         Int?
  toppingIds  String[]
  note        String   @default("")
  qty         Int
  unitPrice   Int
  lineTotal   Int
}

model Payment {
  id             String         @id @default(uuid())
  orderId        String
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  idempotencyKey String         @unique // khoá chống trùng: gửi lại cùng khoá không trừ tiền lần 2
  amount         Int
  method         PaymentMethod
  walletId       String? // tài khoản ảo bị trừ tiền (null khi trả bằng điểm)
  wallet         WalletAccount? @relation(fields: [walletId], references: [id], onDelete: SetNull)
  status         PaymentStatus  @default(PROCESSING)
  failureReason  String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([orderId])
}

model Voucher {
  code             String         @id
  type             VoucherType
  label            String
  percent          Int            @default(0)
  maxDiscount      Int            @default(0)
  minOrder         Int            @default(0)
  requiredMethod   PaymentMethod?
  requiresDelivery Boolean        @default(false)
  usageLimit       Int?
  usedCount        Int            @default(0)
  active           Boolean        @default(true)
}

model LoyaltyTransaction {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  orderId   String?
  delta     Int
  reason    String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// Tài khoản ảo (ví điện tử hoặc thẻ) khách liên kết vào BrewLite.
/// Thanh toán thành công thì trừ thẳng vào `balance`; không đủ số dư thì đơn sang PAYMENT_FAILED.
model WalletAccount {
  id           String              @id @default(uuid())
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     PaymentMethod // MOMO | ZALOPAY | SHOPEEPAY | VNPAY | CARD (không dùng POINTS)
  holderName   String
  maskedNumber String // số điện thoại ví hoặc số thẻ đã che, ví dụ "090•••4567", "•••• 4242"
  balance      Int // số dư, đơn vị đồng, không bao giờ âm
  createdAt    DateTime            @default(now())
  transactions WalletTransaction[]
  payments     Payment[]

  @@unique([userId, provider]) // mỗi loại ví/thẻ liên kết 1 tài khoản
}

/// Sổ biến động số dư: mỗi lần nạp hoặc trừ tiền ghi 1 dòng
model WalletTransaction {
  id           String        @id @default(uuid())
  walletId     String
  wallet       WalletAccount @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type         WalletTxType
  amount       Int // dương = cộng tiền, âm = trừ tiền
  balanceAfter Int
  orderId      String?
  note         String
  createdAt    DateTime      @default(now())

  @@index([walletId, createdAt])
}
