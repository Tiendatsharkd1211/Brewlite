# Sao chép file này thành .env rồi sửa giá trị nếu cần
PORT=3001
FRONTEND_URL=http://localhost:3000
# PostgreSQL chạy bằng Docker (docker compose up -d db), chỉ mở cổng 5433 cho chính máy này
# DIRECT_URL: tài khoản chủ CSDL, chỉ dùng để tạo bảng (prisma db push) và rào CSDL (npm run db:harden)
DIRECT_URL=postgresql://brewlite:brewlite@localhost:5433/brewlite?schema=public
# DATABASE_URL: tài khoản app, chỉ đọc/ghi dữ liệu. db:harden tự tạo tài khoản này theo tên và mật khẩu ghi ở đây
DATABASE_URL=postgresql://brewlite_app:brewlite_app_dev@localhost:5433/brewlite?schema=public
# Khoá ký token đăng nhập (JWT). Khi chạy production bắt buộc là chuỗi ngẫu nhiên >= 32 ký tự, ví dụ tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# ----- Cổng thanh toán VNPay (môi trường thử sandbox) -----
# Đăng ký miễn phí tại https://sandbox.vnpayment.vn/devreg/ , VNPay gửi 2 mã này qua email.
# KHÔNG đưa HashSecret lên GitHub (file .env đã nằm trong .gitignore).
VNP_TMN_CODE=
VNP_HASH_SECRET=
# Các dòng dưới để trống thì dùng mặc định của sandbox
# VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# VNP_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
# VNP_RETURN_URL=http://localhost:3000/payment/vnpay-return
