# Sao chép file này thành .env rồi sửa giá trị nếu cần
PORT=3001
FRONTEND_URL=http://localhost:3000
# PostgreSQL chạy bằng Docker (docker compose up -d db) mở ở cổng 5433 trên máy
DATABASE_URL=postgresql://brewlite:brewlite@localhost:5433/brewlite?schema=public
# Khoá ký token đăng nhập (JWT). Đổi thành chuỗi ngẫu nhiên dài khi triển khai thật.
JWT_SECRET=doi-chuoi-nay-thanh-mot-chuoi-bi-mat-dai
